# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿 — `cp .env.example .env` 후 실제 값을 채운다.
#
# ⚠️ 이 저장소는 PUBLIC 이다. `.env` 는 .gitignore 로 제외돼 있으니
#    실제 비밀번호·키는 반드시 `.env` 쪽에만 두고 이 파일에는 넣지 않는다.
#
# ⚠️ 인라인 주석(`KEY=값  # 설명`)을 쓰지 말 것.
#    .properties 파싱에서 `#` 는 줄 첫머리에서만 주석이라 뒤쪽이 값에 붙고,
#    `export $(grep -v '^#' .env | xargs)` 방식에서도 토큰이 깨진다.
#    설명은 반드시 윗줄에 단독으로 적는다.
#
# ⚠️ Spring 이 `.env` 를 자동으로 읽지는 않는다. 아래 중 하나가 필요하다.
#      - 셸에서 주입:  export $(grep -v '^#' .env | xargs) && ./gradlew bootRun
#      - IntelliJ:     Run Configuration → Environment variables → .env 파일 지정
#      - direnv 사용:  `.envrc` 에 `dotenv` 한 줄
#
# 기본값 유무: application.yml 에 `${VAR}` 로만 적힌 것은 값이 없으면 기동 실패한다.
#              `${VAR:기본값}` 인 것은 아예 정의하지 않으면 기본값이 쓰인다.
#
# ⚠️ `KEY=` (빈 값)은 "미설정"이 아니다. `set -a && . ./.env` 로 주입하면 빈 문자열이
#    환경변수로 들어가고, `${VAR:기본값}` 의 기본값은 **적용되지 않는다**(Spring 의 `:` 는
#    미정의일 때만 동작한다). 기본값을 쓰고 싶으면 그 줄을 `#` 로 주석 처리할 것.
# ─────────────────────────────────────────────────────────────

# ── 프로파일 / 포트 ──────────────────────────────────────────
# 둘 다 기본값 있음 (local / 8080)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ── 데이터베이스 ─────────────────────────────────────────────
# application.yml 에는 기본값이 없다. local 프로파일에서만
# jdbc:postgresql://localhost:5433/petkok · root 로 대체된다.
# DB_PASSWORD 는 local 에도 기본값이 없다 — 없으면 기동 시점에 즉시 실패한다.
# 스키마 소유는 Flyway 다 (AGENTS.md §5) — 대시보드/psql 수동 DDL 금지.
#
# ⚠️ 포트를 확인할 것. 여러 메이저 버전을 병행 설치하면 버전마다 포트가 다르다
#    (Postgres.app 예: 17 → 5433). 잘못 짚으면 다른 버전의 빈 DB 에 조용히 붙는다.
#    운영(Supabase)이 17.x 이므로 로컬도 17 을 쓴다.
DB_URL=jdbc:postgresql://localhost:5433/petkok
DB_USERNAME=root
DB_PASSWORD=

# 스키마는 프로파일이 정한다 — local/dev/prod = petkok_local/petkok_dev/petkok_prod.
# 이 변수는 그 기본값을 덮어쓸 때만 채운다(예: 같은 DB 에 임시 스키마를 하나 더 파서 검증).
# Flyway 와 Hibernate 가 같은 값을 보므로 여기만 바꾸면 양쪽이 함께 움직인다.
#DB_SCHEMA=

# ── JWT ──────────────────────────────────────────────────────
# JWT_SECRET 은 운영에서 반드시 주입해야 한다 (local 은 더미 기본값 존재).
# HS256 기준 최소 32바이트 이상 권장.
JWT_SECRET=
# 30분
JWT_ACCESS_TTL=1800000
# 14일
JWT_REFRESH_TTL=1209600000

# ── Cloudflare R2 (S3 호환) ──────────────────────────────────
# 전부 더미 기본값이 있어 gallery 구현 전까지는 비워 둬도 기동된다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=petkok
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
